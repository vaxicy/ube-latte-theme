{
  "manifest_version": 3,
  "name": "Ube Latte Theme",
  "version": "1.0.0",
  "description": "A creamy lavender-purple Chrome theme inspired by ube latte — soft lilac chrome over a milky pink page.",
  "icons": {
    "128": "logo/logo.png"
  },
  "theme": {
    "colors": {
      "frame":                        [179, 168, 232],
      "frame_inactive":               [198, 190, 238],
      "toolbar":                      [242, 201, 224],
      "tab_text":                     [58, 42, 69],
      "bookmark_text":                [58, 42, 69],
      "ntp_background":               [246, 235, 240],
      "ntp_text":                     [58, 42, 69],
      "ntp_link":                     [123, 76, 147],
      "ntp_header":                   [242, 201, 224],
      "button_background":            [242, 201, 224],
      "button_background_secondary":  [230, 139, 200],
      "omnibox_background":           [255, 255, 255],
      "omnibox_text":                 [58, 42, 69],
      "toolbar_button_icon":          [58, 42, 69]
    },
    "properties": {
      "ntp_button_background":    [230, 139, 200],
      "ntp_button_hover":         [217, 123, 191],
      "ntp_logo_alternate":       1,
      "ntp_single_row_shortcuts": true
    },
    "color_scheme": "light",
    "default_color_scheme": "light"
  }
}
